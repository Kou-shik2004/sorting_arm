# syntax=docker/dockerfile:1

# this image owns compile and deterministic checks, so it has no GUI stack

FROM ros:jazzy-ros-base-noble

ARG DEBIAN_FRONTEND=noninteractive

COPY .docker/packages/ci.txt /tmp/ci.txt
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    pkgs="$(grep -vE '^[[:space:]]*(#|$)' /tmp/ci.txt)" \
 && [ -n "$pkgs" ] \
 && apt-get update && apt-get install -y --no-install-recommends $pkgs

COPY .docker/packages/ci-ros.txt /tmp/ci-ros.txt
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    pkgs="$(grep -vE '^[[:space:]]*(#|$)' /tmp/ci-ros.txt)" \
 && [ -n "$pkgs" ] \
 && apt-get update && apt-get install -y --no-install-recommends $pkgs

RUN rosdep update --rosdistro jazzy

COPY .docker/ci.sh /usr/local/bin/sorting-arm-ci
RUN chmod +x /usr/local/bin/sorting-arm-ci

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/sorting-arm-ci"]
