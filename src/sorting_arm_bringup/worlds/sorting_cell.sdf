<?xml version="1.0"?>
<sdf version="1.8">
  <world name="sorting_cell">

    <!-- physics type = ignored could have prevented the gripper instability issue as it would have default to
    dart-->
    <!-- Readymade world already used bullet featherstone and it was a blunder not to change it to
    dart -->
    <!-- refer /sorting_arm_ws/docs/rca/gripper-grasp-instability.md-->

    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 -1 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <size>100 100</size>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <size>100 100</size>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <pose>0.35 0 0.505 0 0 0</pose>
      <link name="table_link">
        <collision name="top_collision">
          <pose>0 0 -0.030 0 0 0</pose>
          <geometry>
            <box>
              <size>1.10 1.00 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 -0.030 0 0 0</pose>
          <geometry>
            <box>
              <size>1.10 1.00 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.3 0.1 1</ambient>
            <diffuse>0.5 0.3 0.1 1</diffuse>
          </material>
        </visual>

        <collision name="leg_fl_collision">
          <pose>0.50 0.45 -0.280 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.45</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg_fl_visual">
          <pose>0.50 0.45 -0.280 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.45</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.2 0.05 1</ambient>
            <diffuse>0.4 0.2 0.05 1</diffuse>
          </material>
        </visual>

        <collision name="leg_fr_collision">
          <pose>0.50 -0.45 -0.280 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.45</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg_fr_visual">
          <pose>0.50 -0.45 -0.280 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.45</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.2 0.05 1</ambient>
            <diffuse>0.4 0.2 0.05 1</diffuse>
          </material>
        </visual>

        <collision name="leg_bl_collision">
          <pose>-0.50 0.45 -0.280 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.45</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg_bl_visual">
          <pose>-0.50 0.45 -0.280 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.45</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.2 0.05 1</ambient>
            <diffuse>0.4 0.2 0.05 1</diffuse>
          </material>
        </visual>

        <collision name="leg_br_collision">
          <pose>-0.50 -0.45 -0.280 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.45</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg_br_visual">
          <pose>-0.50 -0.45 -0.280 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.45</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.2 0.05 1</ambient>
            <diffuse>0.4 0.2 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Keep these fixed fixtures identical to SceneManager's MoveIt collision objects. -->
    <model name="red_tray">
      <static>true</static>
      <pose>0.70 0.36 0.500 0 0 0</pose>
      <link name="tray_link">
        <collision name="floor_collision">
          <pose>0 0 0.0025 0 0 0</pose>
          <geometry>
            <box>
              <size>0.24 0.24 0.005</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 0.0025 0 0 0</pose>
          <geometry>
            <box>
              <size>0.24 0.24 0.005</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>

        <collision name="wall_front_collision">
          <pose>0.1175 0 0.025 0 0 0</pose>
          <geometry>
            <box>
              <size>0.005 0.24 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_front_visual">
          <pose>0.1175 0 0.025 0 0 0</pose>
