          </material>
        </visual>

        <collision name="wall_right_collision">
          <pose>0 -0.1175 0.025 0 0 0</pose>
          <geometry>
            <box>
              <size>0.245 0.005 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_right_visual">
          <pose>0 -0.1175 0.025 0 0 0</pose>
          <geometry>
            <box>
              <size>0.245 0.005 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="blue_tray">
      <static>true</static>
      <pose>0.70 -0.36 0.500 0 0 0</pose>
      <link name="tray_link">
        <collision name="floor_collision">
          <pose>0 0 0.0025 0 0 0</pose>
          <geometry>
            <box>
              <size>0.24 0.24 0.005</size>
