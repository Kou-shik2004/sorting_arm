        </collision>
        <visual name="floor_visual">
          <pose>0 0 0.0025 0 0 0</pose>
          <geometry>
            <box>
              <size>0.24 0.24 0.005</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.8 1</ambient>
            <diffuse>0.1 0.1 0.8 1</diffuse>
          </material>
        </visual>

        <collision name="wall_front_collision">
          <pose>0.1175 0 0.025 0 0 0</pose>
          <geometry>
