              <size>0.005 0.24 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>

        <collision name="wall_left_collision">
          <pose>0 0.1175 0.025 0 0 0</pose>
          <geometry>
            <box>
              <size>0.245 0.005 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_left_visual">
          <pose>0 0.1175 0.025 0 0 0</pose>
          <geometry>
