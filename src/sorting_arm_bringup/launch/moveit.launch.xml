<launch>

    <let name="urdf_file_path" value="$(find-pkg-share sorting_arm_description)/urdf/sorting_arm.mock.urdf.xacro"/>
    <let name="rviz_file_path" value="$(find-pkg-share sorting_arm_bringup)/rviz/final_moveit.rviz"/>

    <!-- RSP for tf using urdf and joint states (currently mock comp)-->
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'xacro $(var urdf_file_path)')" type="str"/>
    </node>

    <!-- Load controller_manager from ros2_controller yaml file -->
    <node pkg="controller_manager" exec="ros2_control_node">
        <param from="$(find-pkg-share sorting_arm_bringup)/config/ros2_controllers.yaml"/>
    </node>

    <!-- Load all of the controllers in ros2 controller yaml file  -->
    <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster"/>
    <node pkg="controller_manager" exec="spawner" args="arm_controller"/>
    <node pkg="controller_manager" exec="spawner" args="gripper_controller"/>

    <!-- Main moveit python launch file -->
    <include file="$(find-pkg-share sorting_arm_moveit)/launch/move_group.launch.py"/>

    <include file="$(find-pkg-share sorting_arm_moveit)/launch/moveit_rviz.launch.py">
        <arg name="rviz_config" value="$(var rviz_file_path)"/>
    </include>

</launch>
