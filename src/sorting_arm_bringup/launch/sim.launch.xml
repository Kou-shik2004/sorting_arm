<launch>

    <arg name="gui" default="true" />
    <arg name="rviz_config"
        default="$(find-pkg-share sorting_arm_bringup)/rviz/final_moveit.rviz" />
    <arg name="camera_width" default="1280" />
    <arg name="camera_height" default="960" />
    <arg name="camera_update_rate" default="20" />

    <append_env name="GZ_SIM_RESOURCE_PATH" value="$(find-pkg-share sorting_arm_description)/.." />
    <let name="urdf_file_path"
        value="$(find-pkg-share sorting_arm_description)/urdf/sorting_arm.sim.urdf.xacro" />
    <let name="controllers_file_path"
        value="$(find-pkg-share sorting_arm_bringup)/config/ros2_controllers.yaml" />
    <let name="gazebo_config_path"
        value="$(find-pkg-share sorting_arm_bringup)/config/gz_bridge.yaml" />
    <let name="world_file_path"
        value="$(find-pkg-share sorting_arm_bringup)/worlds/sorting_cell.sdf" />

    <node pkg="ros_gz_bridge" exec="parameter_bridge">
        <param name="config_file" value="$(var gazebo_config_path)" />
    </node>

    <set_parameter name="use_sim_time" value="true" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description"
            value="$(command 'xacro $(var urdf_file_path) controllers_file:=$(var controllers_file_path) camera_width:=$(var camera_width) camera_height:=$(var camera_height) camera_update_rate:=$(var camera_update_rate)')"
            type="str" />
    </node>

    <group if="$(var gui)">
        <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
            <arg name="gz_args" value="$(var world_file_path) -r" />
            <arg name="on_exit_shutdown" value="true" />
        </include>
    </group>

    <group unless="$(var gui)">
        <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
            <arg name="gz_args" value="$(var world_file_path) -r -s" />
            <arg name="on_exit_shutdown" value="true" />
        </include>
    </group>

    <node pkg="ros_gz_sim" exec="create"
        args="-world sorting_cell -topic robot_description -name sorting_arm" />

    <node pkg="controller_manager" exec="spawner"
        args="joint_state_broadcaster --controller-manager-timeout 60" />
    <node pkg="controller_manager" exec="spawner"
        args="arm_controller --controller-manager-timeout 60" />
    <node pkg="controller_manager" exec="spawner"
        args="gripper_controller --controller-manager-timeout 60" />

    <!-- Main moveit python launch file -->
    <include file="$(find-pkg-share sorting_arm_moveit)/launch/move_group.launch.py" />

    <group if="$(var gui)">
        <node pkg="rviz2" exec="rviz2" args="-d $(var rviz_config)" />
    </group>

</launch>
