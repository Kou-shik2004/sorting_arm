<launch>

    <arg name="object_count" default="4" />
    <arg name="skills_config"
        default="$(find-pkg-share sorting_arm_skills)/config/skills.yaml" />
    <arg name="executive_config"
        default="$(find-pkg-share sorting_arm_executive)/config/executive.yaml" />
    <arg name="perception_config"
        default="$(find-pkg-share sorting_arm_perception)/config/perception.yaml" />
    <arg name="show_viewer" default="true" />
    <arg name="camera_update_rate" default="30" />
    <arg name="viewer_scale" default="1.0" />
    <arg name="gui" default="true" />

    <include file="$(find-pkg-share sorting_arm_bringup)/launch/sim.launch.xml">
        <arg name="gui" value="$(var gui)" />
        <arg name="object_count" value="$(var object_count)" />
        <!-- we pin these instead of dropping them - includes share one launch-config
             namespace, so an undeclared camera_width:= on the CLI still leaks in otherwise -->
        <arg name="camera_width" value="1280" />
        <arg name="camera_height" value="960" />
        <arg name="camera_update_rate" value="$(var camera_update_rate)" />
    </include>

    <set_parameter name="use_sim_time" value="true" />

    <include file="$(find-pkg-share sorting_arm_bringup)/launch/skill_server.launch.py">
        <arg name="skills_config" value="$(var skills_config)" />
    </include>

    <include file="$(find-pkg-share sorting_arm_bringup)/launch/perception.launch.xml">
        <arg name="perception_config" value="$(var perception_config)" />
        <arg name="show_viewer" value="$(var show_viewer)" />
        <arg name="viewer_scale" value="$(var viewer_scale)" />
    </include>

    <node pkg="sorting_arm_executive" exec="executive_node" output="screen">
        <param from="$(var executive_config)" />
        <param name="object_count" value="$(var object_count)" type="int" />
    </node>

</launch>
