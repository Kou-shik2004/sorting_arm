<launch>
    <let name ="urdf_path" value="$(find-pkg-share sorting_arm_description)/urdf/sorting_arm.urdf.xacro"/>
    <let name ="rviz_path" value="$(find-pkg-share sorting_arm_bringup)/rviz/sorting_arm.rviz"/>

    <!-- 1. Robot State Publisher -->
    <node pkg ="robot_state_publisher" exec ="robot_state_publisher">
        <param name="robot_description" value ="$(command 'xacro $(var urdf_path)')"/>
    </node>

    <!-- 2. Joint State Publisher Gui -->
    <node pkg ="joint_state_publisher_gui" exec ="joint_state_publisher_gui" />

    <!-- 3. Rviz2-->
    <node pkg ="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_path)"/>

</launch>