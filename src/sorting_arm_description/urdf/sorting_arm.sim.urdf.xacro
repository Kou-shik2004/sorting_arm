<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="sorting_arm">

  <xacro:arg name="controllers_file" default=""/>

  <xacro:include filename="sorting_arm.xacro"/>
  <xacro:include filename="sorting_arm.gazebo_ros2_control.xacro"/>

  <gazebo reference="$(arg tf_prefix)camera_link">
    <sensor name="camera" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.5708</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>15</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
        <optical_frame_id>$(arg tf_prefix)camera_link_optical</optical_frame_id>
        <camera_info_topic>/camera/camera_info</camera_info_topic>
      </camera>
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <visualize>true</visualize>
      <topic>camera</topic>
      <gz_frame_id>$(arg tf_prefix)camera_link_optical</gz_frame_id>
    </sensor>
  </gazebo>

</robot>
