<launch>

    <arg name="show_viewer" default="true" />

    <node pkg="sorting_arm_perception" exec="camera_object_provider" output="screen">
        <param from="$(find-pkg-share sorting_arm_perception)/config/perception.yaml" />
    </node>

    <node pkg="sorting_arm_perception" exec="perception_viewer" output="screen"
        if="$(var show_viewer)" />

</launch>
