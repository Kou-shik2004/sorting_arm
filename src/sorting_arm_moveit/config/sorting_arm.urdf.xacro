<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sorting_arm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import sorting_arm urdf file -->
    <xacro:include filename="$(find sorting_arm_description)/urdf/sorting_arm.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="sorting_arm.ros2_control.xacro" />


    <xacro:sorting_arm_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
